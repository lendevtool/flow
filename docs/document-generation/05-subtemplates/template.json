{
  "code": "sample-subtemplates",
  "name": "子模板和孙模板",
  "templateFormat": "POI_TL_V1",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "分工报告",
    "properties": {
      "title": {
        "type": "string",
        "title": "文件标题"
      },
      "teams": {
        "type": "array",
        "title": "团队列表",
        "items": {
          "type": "object",
          "title": "团队",
          "properties": {
            "team": {
              "type": "string",
              "title": "团队名"
            },
            "overview": {
              "type": "string",
              "title": "团队说明"
            },
            "members": {
              "type": "array",
              "title": "成员",
              "items": {
                "type": "object",
                "title": "成员",
                "properties": {
                  "name": {
                    "type": "string",
                    "title": "姓名"
                  },
                  "role": {
                    "type": "string",
                    "title": "职责"
                  },
                  "note": {
                    "type": "string",
                    "title": "说明"
                  }
                },
                "required": [
                  "name",
                  "role",
                  "note"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "team",
            "overview",
            "members"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "title",
      "teams"
    ],
    "additionalProperties": false
  },
  "renderConfig": {},
  "sampleChildTemplates": {
    "teams": "05-subtemplates/team"
  }
}
