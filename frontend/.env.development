# false 使用 History 路由（/pms/resource），服务端需将页面路由回退到 index.html。
# true 使用 Hash 路由（/#/pms/resource）。
VITE_USE_HASH = 'false'

# 资源公共路径,需要以 /开头和结尾
VITE_PUBLIC_PATH = '/'

# Axios 基础路径
# VITE_AXIOS_BASE_URL = '/api'  # 用于代理
# VITE_AXIOS_BASE_URL = 'http://localhost:7086'

VITE_AXIOS_BASE_URL = '/api'

# 代理配置-target
VITE_PROXY_TARGET = 'http://localhost:7086'
