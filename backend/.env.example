# 复制到 loc.env 后填写实际配置。值直接填写，无需引号。
DB_URL=jdbc:mysql://localhost:3316/flow_uat?sslMode=REQUIRED&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=flow
DB_PASSWORD=replace-with-your-database-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
# 文档中心 SFTP。远端目录相对于 SFTP 登录目录，须提前创建。
DOCUMENT_SFTP_HOST=localhost
DOCUMENT_SFTP_PORT=22
DOCUMENT_SFTP_USERNAME=sftp
DOCUMENT_SFTP_ROOT=documents
# 私钥和 known_hosts 均必填，使用后端进程可读的绝对路径。
# 获取 known_hosts 的步骤见 docs/flow-document-center-integration.md。
DOCUMENT_SFTP_PRIVATE_KEY=
DOCUMENT_SFTP_KNOWN_HOSTS=
DOCUMENT_SFTP_CONNECT_TIMEOUT=5s
DOCUMENT_SFTP_IO_TIMEOUT=30s
DOCUMENT_SFTP_POOL_MAX_TOTAL=8
DOCUMENT_SFTP_POOL_MAX_WAIT=3s
DOCUMENT_SFTP_POOL_IDLE_TIMEOUT=1m
# 仅在用户表为空时用于初始化超级管理员。
# BOOTSTRAP_ADMIN_PASSWORD=
# 可选。启用微软域登录时配置 Active Directory 的 LDAPS 地址。
# AD_LDAPS_URL=ldaps://dc.company.example:636
# MFA 密钥存储保护密钥。启用 MFA 前，先用 openssl rand -base64 32 生成随机值。
# 同一环境的后端实例使用同一个值。保存在部署侧的密钥管理服务中，恢复数据库备份时也需要。
# 此配置只保护数据库中的 MFA 数据密钥。数据密钥另行生成，在认证安全策略页面保存并发布。
# MFA_KEY_STORAGE_ENCRYPTION_KEY=
FLOW_MAIL_CREDENTIAL_KEY=这里替换成命令生成的完整值
